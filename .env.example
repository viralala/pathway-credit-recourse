# Copy to .env.local for local development. Never commit real values.

# Public origin of this deployment (no trailing slash). Used for canonical URLs, the sitemap,
# robots.txt, social share cards and the Google sign-in return address. Set this to your custom
# domain once it is connected, e.g. https://www.example.in. Defaults to
# https://pathway-credit-recourse.vercel.app.
NEXT_PUBLIC_SITE_URL=

# Accounts (optional). Without both of these the site works in full, and "Sign in", "Save this
# plan", "My plans" and the partner enquiry form stay hidden. Both are public by design (they are
# compiled into the browser bundle); row level security protects the data. Find them in the
# Supabase dashboard under Project Settings > API. NEXT_PUBLIC_ values are read at build time, so
# redeploy after changing them. Never put the service role key anywhere in this project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Enables "Rewrite in simpler words (AI)" via the Anthropic API. Server-side only:
# never prefix it with NEXT_PUBLIC_. Without it, /api/explain returns the built-in EN/HI/MR text.
ANTHROPIC_API_KEY=

# Optional. Model used by /api/explain (default: claude-haiku-4-5).
ANTHROPIC_MODEL=

# Optional, self-hosting only. Set to 1 when serving over HTTPS outside Vercel to add the CSP
# directive upgrade-insecure-requests (Vercel deployments get it automatically). Read at build time.
CSP_UPGRADE_INSECURE_REQUESTS=
