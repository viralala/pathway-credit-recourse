# Copy to .env.local for local development. Never commit real values.

# Public origin of this deployment (no trailing slash). Used for canonical URLs, the sitemap,
# robots.txt and social share cards. Defaults to https://pathway-credit-recourse.vercel.app.
NEXT_PUBLIC_SITE_URL=https://pathway-credit-recourse.vercel.app/

# Optional. Enables "Rewrite in simpler words (AI)" via the Anthropic API. Server-side only:
# never prefix it with NEXT_PUBLIC_. Without it, /api/explain returns the built-in EN/HI/MR text.
ANTHROPIC_API_KEY=

# Optional. Model used by /api/explain (default: claude-haiku-4-5).
ANTHROPIC_MODEL=

# Supabase PostgreSQL & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only. NEVER expose to client or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Bank connect through Setu's Account Aggregator (RBI consent framework). Server-side only:
# never prefix these with NEXT_PUBLIC_. Set all three to switch from the fictional sandbox data to Setu.
# Without them /api/aa serves three demo borrowers ("Sandbox Bank (demo)") and nothing leaves the app.
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
SETU_AA_PRODUCT_INSTANCE_ID=
# Defaults to the Setu sandbox gateway (https://aa-sandbox.setu.co).
SETU_AA_BASE_URL=
